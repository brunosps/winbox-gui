{
  "schema_version": "1.0",
  "ipc_surface": "Tauri commands (sync + async) invoked from src/main.js via window.__TAURI__.invoke",
  "commands": {
    "list_profiles": {"file": "src-tauri/src/lib.rs", "kind": "sync", "returns": "Vec<Profile>"},
    "install_profile": {"file": "src-tauri/src/lib.rs", "kind": "async", "emits_progress": true, "params": ["InstallParams"]},
    "launch_profile": {"file": "src-tauri/src/lib.rs:257", "kind": "async", "dispatches": ["launch_rdp", "open_web_vnc_window"], "emits_progress": true},
    "open_web_vnc": {"file": "src-tauri/src/lib.rs:333", "kind": "sync", "opens": "WebView with noVNC URL (autoconnect=true&resize=scale)"},
    "update_profile": {"file": "src-tauri/src/lib.rs", "kind": "async", "params": ["UpdateParams"]},
    "restart_profile": {"file": "src-tauri/src/lib.rs", "kind": "async"},
    "stop_profile": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "kill_profile": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "pause_profile": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "resume_profile": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "set_default_profile": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "remove_profile": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "get_profile_config": {"file": "src-tauri/src/lib.rs", "kind": "sync", "returns": "ProfileConfig (password stripped)"},
    "get_logs": {"file": "src-tauri/src/lib.rs", "kind": "sync", "params": ["name", "tail"]},
    "version": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "list_supported_distros": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "list_bundles": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "host_info": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "host_health": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "pick_iso_file": {"file": "src-tauri/src/lib.rs:316", "kind": "async", "uses": "tauri-plugin-dialog"},
    "list_host_gpus": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "gpu_setup_status": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "gpu_setup_apply": {"file": "src-tauri/src/lib.rs", "kind": "async"},
    "gpu_setup_revert": {"file": "src-tauri/src/lib.rs", "kind": "async"},
    "list_snapshots": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "create_snapshot": {"file": "src-tauri/src/lib.rs", "kind": "async"},
    "rollback_snapshot": {"file": "src-tauri/src/lib.rs", "kind": "async"},
    "reapply_bundles": {"file": "src-tauri/src/lib.rs", "kind": "sync"},
    "update_profile_image": {"file": "src-tauri/src/lib.rs", "kind": "async"}
  },
  "cli_surface": {
    "file": "src-tauri/src/cli.rs",
    "mirrors_ipc": true,
    "subcommands_keywords": ["install", "launch", "stop", "kill", "remove", "list", "logs", "snapshot", "default", "update", "version"]
  },
  "events_emitted": {
    "operation:progress": "Per-profile operation lifecycle (prepare/work/done/error)",
    "operation:result": "Final result with op + message"
  },
  "external_processes_spawned": {
    "docker": "src-tauri/src/core/docker.rs (compose, ps, logs, pause/unpause, stop, kill, rm, pull, info)",
    "xfreerdp3": "src-tauri/src/core/rdp.rs:54 — RDP client with systemd-inhibit wrapper",
    "xrandr": "src-tauri/src/core/rdp.rs:10 — HiDPI scale detection (best-effort)",
    "xdg-open": "src-tauri/src/commands/launch.rs (legacy CLI path for web-VNC)",
    "lspci": "src-tauri/src/core/gpu.rs (GPU enumeration)"
  }
}
